{
  "name": "sondra-ad",
  "private": true,
  "version": "1.0.4",
  "license": "MIT",
  "type": "module",
  "description": "Sondra AD — Automatischer Hintergrund-Downloader für die Sondra-Merkliste.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "start": "node desktop/headless.mjs",
    "typecheck": "tsc -b --noEmit",
    "verify": "esbuild scripts/verify-all.mts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.verify-all.mjs && node node_modules/.verify-all.mjs",
    "verify:e2e": "node scripts/e2e/run.mjs",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "youtubei.js": "^18.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.25.5",
    "playwright-core": "^1.56.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
